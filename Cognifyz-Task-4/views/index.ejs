<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Form App</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav class="navbar"> 
        <h2>
            User Data App
        </h2>
    <div class="nav-links">
        <a href="/" data-route="home">Home</a>
        <a href="/register" data-route="register">Register</a>
        <a href="/profile" data-route="profile">Profile</a>
    </div>
  </nav>

  <main>
    
    <section id="home" class="page">

        <div class="hero">
            <h1>
                Dynamic User Registration
            </h1>
            <p>
                Advance validation,dynamic DOM
                 manipulation and client-side routing.
            </p>
            <button
            class="primary-btn"
            data-route="register">
            Create Account
            </button>
        </div>
    </section>
    <section
        id="register"
        class="page hidden">
        <div class="form-container">
            <h1>Create Account</h1>
            <form id="registrationForm">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input 
                    type="text"
                    id="name"
                    placeholder="Enter your name">
                    <small
                    id="nameError"
                    class="error">  
                    </small>
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input 
                    type="email"
                    id="email"
                    placeholder="Enter your email">
                    <small
                    id="emailError"
                    class="error">  
                    </small>
                </div>
                <div class="form-group">
                    <label for="password">Password</label>
                    <input 
                    type="password"
                    id="password"
                    placeholder="Enter Password">
                   <div class="strength-container">
                    <div
                        id="strengthBar"
                        class="strength-bar">
                    </div>
                   </div>
                   <p id="passwordStrength">
                    Password strength:
                   </p>
                   <ul id="passwordRules">
                    <li id="lengthRule">
                        At least 8 characters
                    </li>
                    <li id="uppercaseRule">
                        One uppercase letter

                    </li>
                     <li id="numberRule">
                        One number
                    </li>
                    <li id="lowercaseRule">
                        One lowercase letter

                    </li>
                    <li id="specialRule">
                        One special character

                    </li>
                   </ul>
                </div>
                <div class="form-group">
                    <label for="ConfirmPassword">Confirm password</label>
                    <input 
                    type="password"
                    id="confirmPassword"
                    placeholder="Confirm Password">
                   
                    <small
                        id="confirmError"
                        class="error">
                </small>
                   </div>
                   <div class="form-group">
                    <label for="age">
                        Age
                    </label>
                    <input
                    type="number"
                    id="age"
                    placeholder="Enter age">
                    <small 
                    id="ageError"
                    class="error">
                    </small>

                   </div>
                   <button
                        type="submit"
                        class="primary-btn">

                        Register

                    </button>

                </form>

            </div>

        </section>


        

        <section
            id="profile"
            class="page hidden">

            <div class="profile-container">

                <h1>Your Profile</h1>

                <div class="profile-card">

                    <h2 id="profileName">
                        No user registered
                    </h2>

                    <p id="profileEmail">
                    </p>

                    <p id="profileAge">
                    </p>

                </div>

                <button
                    class="primary-btn"
                    data-route="register">

                    Edit Profile

                </button>

            </div>

        </section>

    </main>


    <script src="/script.js"></script>

</body>

</html>